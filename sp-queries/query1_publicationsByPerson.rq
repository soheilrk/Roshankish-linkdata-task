

PREFIX :     <https://example.org/link-dat/>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?person ?personName ?publication ?title ?doi ?date ?venue ?peerReviewed ?openAccessStatus
WHERE {
    ?authorship a vivo:Authorship ;
                vivo:relates ?person ;
                vivo:relates ?publication .

    ?person a foaf:Person ;
            rdfs:label ?personName .

    ?publication a bibo:Article ;
                 rdfs:label ?title ;
                 bibo:doi ?doi ;
                 vivo:dateTimeValue ?dateValue ;
                 vivo:hasPublicationVenue ?venueResource ;
                 :peerReviewed ?peerReviewed ;
                 :openAccessStatus ?openAccessStatus .

    ?dateValue vivo:dateTime ?date .
    ?venueResource rdfs:label ?venue .
}